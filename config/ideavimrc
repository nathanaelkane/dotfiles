" IdeaVim actions: https://gist.github.com/zchee/9c78f91cc5ad771c1f5d

nnoremap <Space> <Nop>
let mapleader = " "

set hlsearch
set ignorecase
set smartcase
set incsearch
set notimeout
set scrolloff=3

" Plugins

set surround
set easymotion
set commentary
set highlightedyank
set NERDTree
set which-key
set textobj-indent

let g:WhichKeyDesc_goto_file = "<leader><leader> Go to file"
nmap <Leader><Leader> <Action>(GotoFile)

" Actions

let g:WhichKeyDesc_actions = "<leader>c Actions"

nmap <Leader>cf <Action>(CopyContentRootPath)
let g:WhichKeyDesc_copy_path = "<leader>cf Copy path"

nmap <Leader>cl <Action>(CopyPathWithLineNumber)
let g:WhichKeyDesc_copy_path_with_line_number = "<leader>cl Copy path with line number"

nmap <Leader>cd <Action>(ShowErrorDescription)
let g:WhichKeyDesc_show_error = "<leader>cd Show error description"

map <Leader>ca <Action>(ShowIntentionActions)
let g:WhichKeyDesc_code_actions = "<leader>ca Code actions…"

map <Leader>cr <Action>(RenameElement)
let g:WhichKeyDesc_refactor_menu = "<leader>cr Rename element…"

" EasyMotion

let g:EasyMotion_do_mapping = 0
let g:WhichKeyDesc_easymotion_e = "<leader>e EasyMotion…"

map <Leader>ee <Plug>(easymotion-s)
let g:WhichKeyDesc_easymotion_ee = "<leader>ee EasyMotion search {char} forward and backward"

map <Leader>ew <Plug>(easymotion-w)
let g:WhichKeyDesc_easymotion_ew = "<leader>ew EasyMotion word forward"

map <Leader>eb <Plug>(easymotion-b)
let g:WhichKeyDesc_easymotion_eb = "<leader>eb EasyMotion word backward"

map <Leader>ej <Plug>(easymotion-j)
let g:WhichKeyDesc_easymotion_ej = "<leader>ej EasyMotion line downward"

map <Leader>ek <Plug>(easymotion-k)
let g:WhichKeyDesc_easymotion_ek = "<leader>ek EasyMotion line upward"

" Find/highlight

nmap <Leader>h viwy/\V<C-R>"<CR><C-o>
vmap <Leader>h y/\V<C-R>"<CR><C-o>
let g:WhichKeyDesc_highlight_word_or_selection = "<leader>h Highlight word/selection"

nmap <Leader>H viw<Action>(FindInPath)
vmap <Leader>H <Action>(FindInPath)
let g:WhichKeyDesc_find_word_or_selection1 = "<leader>H Find word/selection"

nmap <Leader>sw viw<Action>(FindInPath)
vmap <Leader>sw <Action>(FindInPath)
let g:WhichKeyDesc_find_word_or_selection2 = "<leader>sw Find word/selection"

nmap <Esc> :nohl<CR>
nmap <Leader>/ :nohl<CR>
let g:WhichKeyDesc_clear_highlight = "<leader>/ Clear highlight"

" Project/NERDTree

nmap - :NERDTreeToggle<CR>
nmap <Leader>n :NERDTreeToggle<CR>
let g:WhichKeyDesc_toggle_explorer = "<leader>n Toggle Project/Explorer"

nmap <Leader>. :NERDTreeFind<CR>
let g:WhichKeyDesc_find_file_in_explorer = "<leader>. Find file in Project/Explorer"

" Tests

let g:WhichKeyDesc_test = "<leader>t Test…"

nmap <Leader>tt <Action>(RiderUnitTestRunContextAction)
let g:WhichKeyDesc_test_nearest = "<leader>tt Test line/nearest"

nmap <Leader>td <Action>(RiderUnitTestDebugContextAction)
let g:WhichKeyDesc_debug_nearest = "<leader>td Debug line/nearest"

nmap <leader>tc gg/class<CR><Action>(RiderUnitTestRunContextAction)
let g:WhichKeyDesc_test_class = "<leader>tc Run class"

map <Leader>tl <Action>(RiderUnitTestRepeatPreviousRunAction)
let g:WhichKeyDesc_rerun_last = "<leader>tl Re-run last"

" Run

" map <Leader>rc <Action>(ChooseRunConfiguration)
" map <Leader>rx <Action>(RerunFailedTests)
" map <Leader>rs <Action>(Stop)

" Buffers/Tabs

let g:WhichKeyDesc_buffer = "<leader>b Buffers/tabs…"

nmap <Leader>bd <Action>(CloseEditor)
let g:WhichKeyDesc_close_tab = "<leader>bd Close active editor/tab"

nmap <Leader>ba <Action>(CloseAllEditors)
let g:WhichKeyDesc_close_all_editors = "<leader>ba Close all editors/tabs"

nmap <Leader>bo <Action>(CloseAllEditorsButActive)
let g:WhichKeyDesc_close_all_editors_but_active = "<leader>bo Close all editors/tabs but active"

nmap <Leader>br <Action>(CloseAllToTheRight)
let g:WhichKeyDesc_close_all_to_the_right = "<leader>br Close all editors/tabs to the right"

nmap <Leader>bl <Action>(CloseAllToTheLeft)
let g:WhichKeyDesc_close_all_to_the_left = "<leader>bl Close all editors/tabs to the left"

nmap <Leader>1 :tabn 1<CR>
let g:WhichKeyDesc_tab1 = "<leader>1 Go to tab 1"

nmap <Leader>2 :tabn 2<CR>
let g:WhichKeyDesc_tab2 = "<leader>2 Go to tab 2"

nmap <Leader>3 :tabn 3<CR>
let g:WhichKeyDesc_tab3 = "<leader>3 Go to tab 3"

nmap <Leader>4 :tabn 4<CR>
let g:WhichKeyDesc_tab4 = "<leader>4 Go to tab 4"

nmap <Leader>5 :tabn 5<CR>
let g:WhichKeyDesc_tab5 = "<leader>5 Go to tab 5"

nmap <Leader>6 :tabn 6<CR>
let g:WhichKeyDesc_tab6 = "<leader>6 Go to tab 6"

nmap <Leader>7 :tabn 7<CR>
let g:WhichKeyDesc_tab7 = "<leader>7 Go to tab 7"

nmap <Leader>8 :tabn 8<CR>
let g:WhichKeyDesc_tab8 = "<leader>8 Go to tab 8"

nmap <Leader>9 :tabn 9<CR>
let g:WhichKeyDesc_tab9 = "<leader>9 Go to tab 9"


" Unimpaired

let g:WhichKeyDesc_prev = "[ Prev"
let g:WhichKeyDesc_next = "] Next"

nmap [b <Action>(PreviousTab)
let g:WhichKeyDesc_prev_tab = "[b Prev tab"
nmap ]b <Action>(NextTab)
let g:WhichKeyDesc_next_method = "]b Next tab"

nmap [m <Action>(MethodUp)
let g:WhichKeyDesc_prev_method1 = "[m Prev method"
nmap ]m <Action>(MethodDown)
let g:WhichKeyDesc_next_method1 = "]m Next method"

nmap ]f <Action>(MethodDown)
let g:WhichKeyDesc_prev_method2 = "[f Prev method"
nmap [f <Action>(MethodUp)
let g:WhichKeyDesc_next_method2 = "]f Next method"

nmap [h <Action>(VcsShowPrevChangeMarker)<Esc>
let g:WhichKeyDesc_prev_change = "[h Prev change"
nmap ]h <Action>(VcsShowNextChangeMarker)<Esc>
let g:WhichKeyDesc_next_change = "]h Next change"

nmap [q <Action>(PreviousOccurence)
let g:WhichKeyDesc_prev_occurence = "[q Prev occurence"
nmap ]q <Action>(NextOccurence)
let g:WhichKeyDesc_next_occurence = "]q Next occurence"

nmap [d <Action>(GotoPreviousError)
let g:WhichKeyDesc_prev_error = "[d Prev error/diagnostic"
nmap ]d <Action>(GotoNextError)
let g:WhichKeyDesc_next_error = "]d Next error/diagnostic"

nmap yoa <Action>(Annotate)
let g:WhichKeyDesc_toggle_annotate = "yoa Toggle annotate (with git blame)"

nmap yow <Action>(EditorToggleUseSoftWraps)
let g:WhichKeyDesc_toggle_soft_wrap = "yow Toggle soft wrap"

" Misc mappings

map Y y$

" Use "very magic" search mode
nnoremap / /\v
vnoremap / /\v

" Copy/paste
noremap <Leader>y "*y
nnoremap <Leader>yy "*yy
noremap <Leader>p "*p
noremap <Leader>P "*P

" Jump to prev file
nnoremap <Leader>` <C-6>
let g:WhichKeyDesc_prev_file = "<leader>` Prev file"

" Reselect visual block after indent
vnoremap < <gv
vnoremap > >gv

" Jump to start or end of line
noremap H ^
noremap L $

" Bubble lines up and down
map <A-K> <Action>(MoveLineUp)
map <A-J> <Action>(MoveLineDown)

" Toggle fold
nmap <Tab> <Action>(ExpandCollapseToggleAction)

" Select all
nmap <Leader>a <Action>($SelectAll)

" Hide active tool window
" nmap <Leader>` <Action>(HideActiveWindow)

" Find file under cursor
vmap gf <Action>(GotoFile)
let g:WhichKeyDesc_goto_file_under_cursor = "gf 'Go to File' using selected text"

" Toggle debug breakpoint
nmap <Leader>db :action ToggleLineBreakpoint<CR>

" rails.vim commands
command! A :action GotoTest
